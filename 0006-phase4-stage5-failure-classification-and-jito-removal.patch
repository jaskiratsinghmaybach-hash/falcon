+            (FailureClass::InvalidPoolState, "invalid_pool_state"),
+            (FailureClass::MissingTickArray, "missing_tick_array"),
+            (FailureClass::ArithmeticError, "arithmetic_error"),
+            (FailureClass::ExecutionError, "execution_error"),
