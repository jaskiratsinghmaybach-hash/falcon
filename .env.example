HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
HELIUS_WS_URL=wss://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# HELIUS_WS_URL_2=...
# HELIUS_WS_URL_3=...
WALLET_PRIVATE_KEY=base58_secret_key
PAIR=USELESSSOL
RAYDIUM_POOL_ID=Q2sPHPdUWFMg7M7wwrQKLrn619cAucfRsmhVJffodSp
ORCA_POOL_ID=HsQGWEh3ib6w59rBh5n1jXmi8VXFBqKEjxozL6PGfcgb
DECODER=CPMM
# WALLET = trade with wallet SOL (capped by MAX_TRADE_SIZE_LAMPORTS)
# POOL   = borrow the trade size via a Kamino flash loan in the same tx
MTS=WALLET
MAX_TRADE_SIZE_LAMPORTS=50000000
MAX_PRICE_AGE_SECS=0

# Atomic execution
# 1 = broadcast transactions that pass simulation. Default off (simulate-only).
LIVE_TRADING=0
# Net profit (after fees) each trade must clear; enforced on-chain by the sell leg's minimum_out.
MIN_PROFIT_LAMPORTS=0
# Minimum ms between live sends.
EXEC_COOLDOWN_MS=2000

# Flash loans (MTS=POOL)
# KAMINO_RESERVE=d4A2prbA2whesmvHaL88BH6Ewn5N4bTSU2Ze8P6Bc4Q   # Kamino main-market SOL reserve (default)
# LOOKUP_TABLES=284iwGtA9X9aLy3KsyV8uT2pXLARhYbiSi5SiM2g47M2    # comma-separated ALTs; POOL defaults to Kamino's

# Jito: tip > 0 sends through the block engine (bundleOnly, revert-protected); 0 = plain RPC
JITO_TIP_LAMPORTS=0
# JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf
