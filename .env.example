# --- required ---
HELIUS_RPC_URL=
HELIUS_WS_URL=
# HELIUS_WS_URL_2=   (extra keys spread the 12 WebSocket subscriptions)
# HELIUS_WS_URL_3=
WALLET_PRIVATE_KEY=          # base58; use a DEDICATED low-balance wallet
PAIR=USELESSSOL
RAYDIUM_POOL_ID=
ORCA_POOL_ID=
DECODER=CPMM
MTS=WALLET
MAX_TRADE_SIZE_LAMPORTS=50000000   # hard per-trade ceiling

# --- execution mode: OBSERVE | PAPER (default) | LIVE ---
EXECUTION_MODE=PAPER
# LIVE additionally requires: MTS=WALLET and
# LIVE_TRADING_ACK=I_ACCEPT_REAL_FUNDS_RISK

# --- risk limits (all optional; defaults are conservative) ---
# MIN_PROFIT_LAMPORTS=50000
# DEDUPE_WINDOW_MS=1000
# WALLET_RESERVE_LAMPORTS=10000000
# MAX_LIVE_TRADES=10
# MAX_CONSECUTIVE_LIVE_FAILURES=3
# MAX_SESSION_LOSS_LAMPORTS=10000000
# KILL_SWITCH_FILE=HALT      # `touch HALT` stops LIVE trading

# --- diagnostics ---
# FORCE_SIM=1                # simulate a round trip even with no spread
# ORCA_POLL_MS=750
# RUST_LOG=info
